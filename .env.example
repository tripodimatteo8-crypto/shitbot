# --- Obbligatoria per l'agente Claude (senza: gira la strategia "baseline" a regole) ---
ANTHROPIC_API_KEY=

# --- Opzionali (non ancora usate in Fase 1) ---
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GMGN_API_KEY=

# auto | claude | claude_cli | baseline
#  auto       = il tuo abbonamento Claude (Pro/Max) tramite la CLI `claude` di Claude Code (prioritario),
#               altrimenti API se c'è ANTHROPIC_API_KEY, altrimenti baseline a regole
#  claude_cli = forza l'uso dell'abbonamento (serve `claude` installato e login fatto)
DECIDER=auto
# Percorso della CLI di Claude Code se non è nel PATH (es. /Users/tuonome/.claude/local/claude)
CLAUDE_CLI_PATH=claude

# --- Quota abbonamento (modificabile anche da dashboard) ---
# SB_CLI_CALLS_PER_WINDOW=12      # chiamate max per finestra (12/5h ≈ 25% di un piano Pro, da tarare con /usage)
# SB_CLI_WINDOW_HOURS=5
# SB_CLI_MODEL=                   # vuoto = default dell'abbonamento; es. sonnet per consumare meno
# SB_CLI_REFLECT_EVERY_HOURS=6
HOST=127.0.0.1
PORT=8787

# --- Override facoltativi dei parametri (prefisso SB_), modificabili anche da dashboard ---
# SB_CLAUDE_MODEL=claude-opus-5-5
# SB_CLAUDE_EFFORT=medium
# SB_MAX_CLAUDE_USD_PER_DAY=15
# SB_INITIAL_CAPITAL_USD=1000
# SB_MAX_POSITION_PCT=5
# SB_STOP_LOSS_PCT=25
# SB_TAKE_PROFIT_PCT=60
# SB_DAILY_LOSS_LIMIT_PCT=8

# --- Modalità live: lasciare DISABILITATA ---
LIVE_TRADING_ENABLED=false
# La chiave del wallet dedicato si imposta SOLO come variabile d'ambiente quando
# il LiveEngine verrà implementato. Mai nel repo, mai nei log.
# SOLBOT_WALLET_PRIVATE_KEY=
